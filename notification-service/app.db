import json
import logging
import os
import threading
import time
import uuid
from datetime import datetime, timezone

import pika
from fastapi import FastAPI
import uvicorn

from app.db import init_db, is_event_processed, record_processed_event

SERVICE_NAME = os.getenv("SERVICE_NAME", "notification-service")
RABBITMQ_HOST = os.getenv("RABBITMQ_HOST", "rabbitmq")
RABBITMQ_PORT = int(os.getenv("RABBITMQ_PORT", "5672"))
RABBITMQ_USER = os.getenv("RABBITMQ_USER", "guest")
RABBITMQ_PASS = os.getenv("RABBITMQ_PASS", "guest")
EXCHANGE_NAME = os.getenv("EXCHANGE_NAME", "maltashop.events")
QUEUE_NAME = os.getenv("QUEUE_NAME", "notifications.order_placed")
BINDING_KEY = os.getenv("BINDING_KEY", "order.placed")
HTTP_PORT = int(os.getenv("HTTP_PORT", "8001"))

logging.basicConfig(
    level=logging.INFO,
    format="%(message)s",
)
logger = logging.getLogger(SERVICE_NAME)

app = FastAPI(title="MaltaShop Notification Service")


def log_event(level: str, message: str, correlation_id: str, **extra: object) -> None:
    payload = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "level": level,
        "service": SERVICE_NAME,
        "correlation_id": correlation_id,
        "message": message,
        **extra,
    }
    logger.info(json.dumps(payload))


def handle_message(ch, method, properties, body: bytes) -> None:
    try:
        event = json.loads(body.decode("utf-8"))
        event_id = event.get("event_id") or str(uuid.uuid4())
        event_type = event.get("event_type", "OrderPlaced")
        data = event.get("data", {})
        order_id = data.get("order_id", "unknown")
        customer_id = data.get("customer_id", "unknown")

        header_corr_id = None
        if properties and properties.headers:
            header_corr_id = properties.headers.get("x-correlation-id")
        correlation_id = event.get("correlation_id") or header_corr_id or str(uuid.uuid4())

        if is_event_processed(event_id):
            log_event(
                "INFO",
                "Duplicate event skipped",
                correlation_id=correlation_id,
                event_id=event_id,
                order_id=order_id,
            )
            ch.basic_ack(delivery_tag=method.delivery_tag)
            return

        log_event(
            "INFO",
            "Order confirmation notification sent",
            correlation_id=correlation_id,
            event_id=event_id,
            event_type=event_type,
            order_id=order_id,
            customer_id=customer_id,
        )

        record_processed_event(
            {
                "event_id": event_id,
                "event_type": event_type,
                "order_id": order_id,
                "customer_id": customer_id,
                "correlation_id": correlation_id,
                "processed_at": datetime.now(timezone.utc).isoformat(),
            }
        )
        ch.basic_ack(delivery_tag=method.delivery_tag)
    except Exception as exc:
        log_event(
            "ERROR",
            "Failed to process event message",
            correlation_id="consumer-error",
            error=str(exc),
        )
        ch.basic_nack(delivery_tag=method.delivery_tag, requeue=False)


def consume_loop() -> None:
    while True:
        try:
            credentials = pika.PlainCredentials(RABBITMQ_USER, RABBITMQ_PASS)
            params = pika.ConnectionParameters(
                host=RABBITMQ_HOST,
                port=RABBITMQ_PORT,
                credentials=credentials,
                heartbeat=30,
            )
            connection = pika.BlockingConnection(params)
            channel = connection.channel()
            channel.exchange_declare(
                exchange=EXCHANGE_NAME,
                exchange_type="topic",
                durable=True,
            )
            channel.queue_declare(queue=QUEUE_NAME, durable=True)
            channel.queue_bind(
                exchange=EXCHANGE_NAME,
                queue=QUEUE_NAME,
                routing_key=BINDING_KEY,
            )
            channel.basic_qos(prefetch_count=1)
            channel.basic_consume(queue=QUEUE_NAME, on_message_callback=handle_message)
            log_event("INFO", "Notification consumer connected to RabbitMQ", correlation_id="consumer-start")
            channel.start_consuming()
        except Exception as exc:
            log_event(
                "WARN",
                "RabbitMQ consumer connection retrying",
                correlation_id="consumer-retry",
                error=str(exc),
            )
            time.sleep(3)


@app.on_event("startup")
def on_startup() -> None:
    init_db()
    consumer_thread = threading.Thread(target=consume_loop, daemon=True)
    consumer_thread.start()
    log_event("INFO", "notification-service started", correlation_id="startup")


@app.get("/health")
def health() -> dict:
    return {"status": "ok", "service": SERVICE_NAME}


if __name__ == "__main__":
    init_db()
    consumer_thread = threading.Thread(target=consume_loop, daemon=True)
    consumer_thread.start()
    uvicorn.run(app, host="0.0.0.0", port=HTTP_PORT)
